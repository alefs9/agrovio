{
  "name": "agrovio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:landing": "npm run dev -w @agrovio/landing",
    "dev:demo": "npm run dev -w @agrovio/demo",
    "dev:frontend": "npm run dev -w @agrovio/frontend",
    "build": "npm run build -w @agrovio/demo && npm run build -w @agrovio/frontend && npm run build -w @agrovio/landing && node scripts/assemble-landing.mjs",
    "build:demo": "npm run build -w @agrovio/demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-strip-types --test packages/domain/tests/*.test.ts",
    "package:demo": "node scripts/package-demo.mjs",
    "preview:demo": "npm run preview -w @agrovio/demo",
    "build:landing": "npm run build",
    "dev:backend": "node scripts/dev-backend.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "typescript": "~6.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.67.2"
  }
}
